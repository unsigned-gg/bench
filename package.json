{
  "name": "unsigned-bench",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir /tmp/wr-build",
    "build:cerebral": "node scripts/build-cerebral.mjs",
    "validate:cerebral": "node scripts/validate-cerebral-bench.mjs",
    "test:cerebral": "node --test tests/cerebral-bench.test.mjs",
    "dev:cerebral": "npm run build:cerebral && wrangler dev --config wrangler.cerebral.jsonc",
    "check:cerebral": "npm run test:cerebral && npm run build:cerebral && npm run test:gallery && wrangler deploy --config wrangler.cerebral.jsonc --dry-run --outdir /tmp/cerebral-bench-worker",
    "deploy:cerebral": "npm run check:cerebral && wrangler deploy --config wrangler.cerebral.jsonc",
    "test:gallery": "node --test tests/cerebral-gallery.test.mjs",
    "test:gallery:browser": "node tests/gallery-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "d3": "7.9.0",
    "d3-geo-projection": "4.0.0",
    "d3-geo-voronoi": "2.1.0",
    "d3-hexbin": "0.2.2",
    "d3-sankey": "0.12.3",
    "esbuild": "0.25.11",
    "geotiff": "3.0.5",
    "playwright": "1.61.1",
    "three": "0.186.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2",
    "wrangler": "4.107.0"
  }
}
